<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Breathy Sage Nature — LIGHT-ONLY palette (spec section 23)             -->
    <!-- No dark mode exists anywhere in the app.                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Background Colors — Three-tier depth system                            -->
    <!-- Deepest layer — full-screen background (warm off-white) -->
    <color name="bg_primary">#F8FAF6</color>
    <!-- Card backgrounds, bottom sheets, dialog surfaces (pure white) -->
    <color name="bg_surface">#FFFFFF</color>
    <!-- Elevated sub-surfaces: input fields, nested cards, dividers -->
    <color name="bg_surface_variant">#EAF3E5</color>
    <!-- Highest elevation surface — modal overlays, dropdown menus -->
    <color name="bg_surface_elevated">#FFFFFF</color>

    <!-- Natural Green — progress bars, success states, CTA buttons -->
    <color name="accent_primary">#6F9B5E</color>
    <!-- Primary pressed state — slightly deeper green -->
    <color name="accent_primary_pressed">#5D874E</color>
    <!-- Primary at 15% opacity — container backgrounds -->
    <color name="accent_primary_container">#266F9B5E</color>
    <!-- Primary at 30% opacity — soft tint effects -->
    <color name="accent_primary_glow">#4D6F9B5E</color>

    <!-- Warm Earth (secondary) -->
    <color name="accent_secondary">#A9825B</color>
    <color name="accent_secondary_pressed">#8F6C4A</color>
    <color name="accent_secondary_container">#26A9825B</color>

    <!-- Info — soft sky -->
    <color name="accent_info">#6FA6B5</color>
    <color name="accent_info_pressed">#5A8FA0</color>
    <color name="accent_info_container">#266FA6B5</color>

    <!-- Warning — natural yellow -->
    <color name="accent_warning">#F1D98A</color>
    <color name="accent_warning_pressed">#E5CB72</color>
    <color name="accent_warning_container">#26F1D98A</color>

    <!-- Premium — deep forest green -->
    <color name="accent_purple">#285C3A</color>
    <color name="accent_purple_pressed">#1F4A2E</color>
    <color name="accent_purple_container">#26285C3A</color>

    <!-- Orange — cravings, urgency -->
    <color name="accent_orange">#C97F6D</color>
    <color name="accent_orange_pressed">#B06B59</color>
    <color name="accent_orange_container">#26C97F6D</color>
    <color name="accent_orange_glow">#40C97F6D</color>

    <!-- Pink — likes, hearts -->
    <color name="accent_pink">#C97F6D</color>
    <color name="accent_pink_pressed">#B06B59</color>
    <color name="accent_pink_container">#26C97F6D</color>

    <!-- Text Colors — Three-level emphasis model -->
    <color name="text_primary">#183D28</color>
    <color name="text_secondary">#5C6B5E</color>
    <color name="text_disabled">#9AA79B</color>
    <color name="text_inverse">#FFFFFF</color>

    <!-- Semantic Colors -->
    <color name="semantic_error">#C0574F</color>
    <color name="semantic_error_container">#26C0574F</color>
    <color name="semantic_success">#6F9B5E</color>
    <color name="semantic_warning">#F1D98A</color>

    <!-- Achievement Colors -->
    <color name="achievement_gold">#F1D98A</color>
    <color name="achievement_silver">#D5E6CC</color>
    <color name="achievement_bronze">#A9825B</color>
    <color name="achievement_gold_container">#33F1D98A</color>
    <color name="achievement_silver_container">#33D5E6CC</color>
    <color name="achievement_bronze_container">#33A9825B</color>

    <!-- Outlines and Dividers -->
    <color name="outline">#AFC8A3</color>
    <color name="outline_variant">#D5E6CC</color>
    <color name="outline_neon">#4D6F9B5E</color>

    <!-- Scrim and Overlay -->
    <color name="scrim">#99183D28</color>
    <color name="overlay_dark">#CC183D28</color>

    <!-- Gradient Colors (referenced in drawables) -->
    <color name="gradient_start_green">#6F9B5E</color>
