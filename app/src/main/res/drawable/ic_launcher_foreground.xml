<?xml version="1.0" encoding="utf-8"?>
<!-- Breathy launcher foreground: breathing lungs formed by two leaves.
     A soft exhale arc floats above; a short stem connects down into the
     twin leaf-lungs with light veins. Recognizable at very small sizes:
     strong symmetric silhouette, 3 shapes, no text. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Exhale breath arc -->
    <path
        android:pathData="M38,32 C42,26.5 48,24 54,24 C60,24 66,26.5 70,32"
        android:strokeColor="#6F9B5E"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Stem / trachea -->
    <path
        android:pathData="M54,37 L54,47"
        android:strokeColor="#285C3A"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Left leaf-lung -->
    <path
        android:fillColor="#3E7350"
        android:pathData="M54,46 C44,40 33,44 30,54 C27.6,62 32.5,70.5 42,73.5 C48,75.4 53,73.4 54,70 Z"/>
    <!-- Right leaf-lung -->
    <path
        android:fillColor="#285C3A"
        android:pathData="M54,46 C64,40 75,44 78,54 C80.4,62 75.5,70.5 66,73.5 C60,75.4 55,73.4 54,70 Z"/>

    <!-- Left vein -->
    <path
        android:pathData="M54,52 C50,51.5 45.5,53.5 42.5,57.5"
        android:strokeColor="#F8FAF6"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
    <!-- Right vein -->
    <path
        android:pathData="M54,52 C58,51.5 62.5,53.5 65.5,57.5"
        android:strokeColor="#F8FAF6"
        android:strokeAlpha="0.92"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Leaf tip highlight: small breathing dot between the lungs -->
    <path
        android:fillColor="#AFC8A3"
        android:pathData="M54,63.2 m-2.3,0 a2.3,2.3 0 1,1 4.6,0 a2.3,2.3 0 1,1 -4.6,0"/>
</vector>
