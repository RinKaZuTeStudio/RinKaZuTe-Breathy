rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  BREATHY — PRODUCTION FIRESTORE RULES (v6, 2026-09)
//  Paste this entire file into Firebase Console → Firestore → Rules → Publish
//  (or deploy with: firebase deploy --only firestore:rules)
//
//  v6 vs v5: the follows/{followId} section is SIMPLIFIED (fewer conditions =
//  nothing extra to reject a legitimate follow) and documents the new v1.0.9
//  owner-managed fields (profilePicture, ownedPictures, picAdWatchCount,
//  weeklyXp/monthlyXp mirrors, animated avatar ids) — all of them flow through
//  the existing owner-update rules, so no NEW collection or privilege was
//  added. If follow still fails after publishing v6, the in-app follow error
//  message now prints the EXACT Firebase project id to verify you edited the
//  right project.
//
//  Carried-over fixes from v5:
//   1. users/{uid} update: owner-only, no full-document re-validation
//      (sparse pre-onboarding documents stay writable).
//   2. users/{uid}/goldTransactions subcollection: append-only Gold ledger.
//   3. publicProfiles owner update without full-state re-validation.
//   4. publicProfiles cross-user updates ONLY for follow counters.
//   5. follows/{followId} rules (the one-way follow graph).
//
//  Nothing is public. The catch-all deny remains last.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.admin == true
          || request.auth.uid in [
            // ── Add your admin UID(s) here — needed for the event
            //    admin review screen (check-in approval) ──────────────
            // "PASTE_ADMIN_UID_HERE"
          ]
        );
    }

    function isFieldOwner(field) {
      return isAuthenticated() &&
        request.auth.uid == resource.data[field];
    }

    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    function isNonNegative(value) {
      return value is int && value >= 0;
    }

    function onlyUpdatingLikes() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['likes', 'likedBy']);
    }

    function onlyUpdatingReadStatus() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['read']);
    }

    function onlyUpdatingFollowCounters() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['followerCount', 'followingCount']);
    }

    function chatParticipants(chatId) {
      return get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants;
    }


    // ═══════════════════════════════════════════════════════════════════
    // users/{userId} — private user data (owner-scoped)
    // ═══════════════════════════════════════════════════════════════════

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isNonEmptyString(request.resource.data.email)
        && request.resource.data.createdAt is timestamp;

      // UPDATE (FIX #1): owner-only. The identity anchors (email, createdAt)
      // cannot be changed once present; everything else (nickname, quitDate,
      // coins, xp, lastDailyClaim, avatarFrame, ownedFrames, payout email,
      // notification/privacy prefs…) is owned data the signed-in user
      // maintains. This keeps the daily reward, Gold balance, avatar frame
      // and payout settings working for EVERY account — including sparse
      // pre-onboarding documents — without weakening protection (delete
      // stays forbidden, and no other user can ever touch this document).
      allow update: if isOwner(userId)
        && (!('email' in resource.data)
            || resource.data.email == request.resource.data.email)
        && (!('createdAt' in resource.data)
            || resource.data.createdAt == request.resource.data.createdAt);

      allow delete: if false;


      // ── FIX #2: the Gold ledger is a SUBCOLLECTION of the user document.
      //    Append-only: the owner can create validated entries (the app
      //    writes them inside the same Firestore transaction that updates
      //    the coins balance, with a dedupKey per reward), but can never
      //    modify or delete ledger history. No other user can read or write
      //    another user's ledger.
      match /goldTransactions/{txId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0
          && isNonEmptyString(request.resource.data.type)
          && isNonEmptyString(request.resource.data.source)
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0;

        allow update: if false;
        allow delete: if false;
      }

      match /coach_chats/{messageId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isNonEmptyString(request.resource.data.content)
          && request.resource.data.role is string
          && request.resource.data.timestamp is timestamp;

        allow update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }
    }


    // ═══════════════════════════════════════════════════════════════════
    // publicProfiles/{userId} — public profile data
    // ═══════════════════════════════════════════════════════════════════

    match /publicProfiles/{userId} {

      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && isNonEmptyString(request.resource.data.nickname)
        && isNonNegative(request.resource.data.xp);

      // OWNER update (FIX #3): owner-only, no full-state re-validation —
      // the old rule denied the daily-reward XP mirror and profile edits
      // whenever any legacy/sparse field was missing. All profile fields
      // remain owner-maintained and publicly READ-only.
      allow update: if isOwner(userId);

      // FIX #4: any authenticated user may maintain ONLY the denormalized
      // follow counters on someone else's profile (FieldValue.increment
      // writes performed by the follow system). No profile data is touched.
      allow update: if isAuthenticated()
        && !isOwner(userId)
        && onlyUpdatingFollowCounters();

      allow delete: if false;
    }


    // ═══════════════════════════════════════════════════════════════════
    // follows/{followId} — one-way FOLLOW / FOLLOWING graph
    // v6: minimal validation — creator follows AS themselves and never
    // follows themselves. (v5 also required createdAt to be a timestamp;
    // dropping it removes the last thing that could reject a legitimate
    // follow. Delete stays follower-only; update stays impossible.)
    // Deterministic id: {followerId}_{followedId}
    // ═══════════════════════════════════════════════════════════════════

    match /follows/{followId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followedId is string
        && request.resource.data.followedId != request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.followerId == request.auth.uid;
    }


    // ═══════════════════════════════════════════════════════════════════
    // stories/{storyId}
    // ═══════════════════════════════════════════════════════════════════

    match /stories/{storyId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && isNonEmptyString(request.resource.data.content)
        && request.resource.data.content.size() <= 2000
        && isNonNegative(request.resource.data.likes)
        && request.resource.data.likedBy is list
        && isNonNegative(request.resource.data.daysSmokeFree)
        && isNonEmptyString(request.resource.data.nickname)
        && request.resource.data.createdAt is timestamp;

      allow update: if isFieldOwner("userId")
        && request.resource.data.userId == resource.data.userId
        && isNonEmptyString(request.resource.data.content)
        && request.resource.data.content.size() <= 2000
        && isNonNegative(request.resource.data.likes)
        && request.resource.data.likedBy is list
        && request.resource.data.createdAt == resource.data.createdAt;

      allow update: if isAuthenticated()
        && onlyUpdatingLikes()
        && isNonNegative(request.resource.data.likes)
        && request.resource.data.likedBy is list;

      allow delete: if isFieldOwner("userId");


      match /replies/{replyId} {

        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.userId
          && isNonEmptyString(request.resource.data.content)
          && request.resource.data.content.size() <= 500
          && request.resource.data.createdAt is timestamp;

        allow update: if isFieldOwner("userId")
          && request.resource.data.userId == resource.data.userId
          && isNonEmptyString(request.resource.data.content)
          && request.resource.data.content.size() <= 500;

        allow delete: if isFieldOwner("userId");
      }
    }


    // ═══════════════════════════════════════════════════════════════════
    // friendRequests/{requestId}
    // ═══════════════════════════════════════════════════════════════════

    match /friendRequests/{requestId} {

      allow get: if isAuthenticated()
        && (
          request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId
        );

      allow list: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && isNonEmptyString(request.resource.data.fromUserId)
        && isNonEmptyString(request.resource.data.toUserId)
        && request.resource.data.status is string
        && request.resource.data.timestamp is timestamp;

      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && (
          request.resource.data.status == "accepted"
          || request.resource.data.status == "rejected"
        );

      allow delete: if false;
    }


    // ═══════════════════════════════════════════════════════════════════
    // friendships/{friendshipId}
    // ═══════════════════════════════════════════════════════════════════

    match /friendships/{friendshipId} {

      allow get: if isAuthenticated()
        && request.auth.uid in resource.data.userIds;

      allow list: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      allow delete: if false;
    }


    // ═══════════════════════════════════════════════════════════════════
    // chats/{chatId}
    // ═══════════════════════════════════════════════════════════════════

    match /chats/{chatId} {

      allow get: if isParticipant(resource.data.participants);

      allow list: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;


      match /messages/{messageId} {

        allow read: if isAuthenticated()
          && isParticipant(chatParticipants(chatId));

        allow create: if isAuthenticated()
          && isParticipant(chatParticipants(chatId))
          && request.auth.uid == request.resource.data.senderId
          && isNonEmptyString(request.resource.data.text)
          && request.resource.data.text.size() <= 2000
          && request.resource.data.timestamp is timestamp
          && request.resource.data.read is bool;

        allow update: if isAuthenticated()
          && isParticipant(chatParticipants(chatId))
          && onlyUpdatingReadStatus();

        allow delete: if false;
      }
    }


    // ═══════════════════════════════════════════════════════════════════
    // events/{eventId}
    // ═══════════════════════════════════════════════════════════════════

    match /events/{eventId} {

      allow read: if isAuthenticated();

      allow write: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════
    // eventParticipants/{participantId}
    // ═══════════════════════════════════════════════════════════════════

    match /eventParticipants/{participantId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && isNonEmptyString(request.resource.data.eventId)
        && isNonEmptyString(request.resource.data.userId)
        && request.resource.data.joinedAt is timestamp;

      allow update: if isAuthenticated()
        && (
          request.auth.uid == resource.data.userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════
    // eventCheckins/{checkinId}
    // ═══════════════════════════════════════════════════════════════════

    match /eventCheckins/{checkinId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && isNonEmptyString(request.resource.data.eventId)
        && isNonEmptyString(request.resource.data.userId)
        && isNonNegative(request.resource.data.dayNumber)
        && isNonEmptyString(request.resource.data.videoURL)
        && request.resource.data.status is string
        && request.resource.data.submittedAt is timestamp;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════
    // craving_logs/{logId}
    // ═══════════════════════════════════════════════════════════════════

    match /craving_logs/{logId} {

      allow get: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      allow list: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && isNonEmptyString(request.resource.data.userId)
        && isNonEmptyString(request.resource.data.copingMethod)
        && request.resource.data.success is bool
        && request.resource.data.timestamp is timestamp;

      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }


    // ═══════════════════════════════════════════════════════════════════
    // subscriptions/{userId}
    // ═══════════════════════════════════════════════════════════════════

    match /subscriptions/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.active is bool
        && isNonEmptyString(request.resource.data.plan);

      allow update: if isOwner(userId)
        && request.resource.data.active is bool;

      allow delete: if isOwner(userId);
    }


    // ═══════════════════════════════════════════════════════════════════
    // goldTransactions/{transactionId}  (TOP-LEVEL path — legacy/backend)
    // ═══════════════════════════════════════════════════════════════════
    // The app writes its ledger under users/{uid}/goldTransactions (above).
    // This top-level path stays admin-managed for trusted backend logic and
    // remains readable for the owner of each record.

    match /goldTransactions/{transactionId} {

      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════
    // reports/{reportId}
    // ═══════════════════════════════════════════════════════════════════

    match /reports/{reportId} {

      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && isNonEmptyString(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp;

      allow read: if isAuthenticated()
        && resource.data.reporterId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════
    // CATCH-ALL — everything not explicitly allowed above is DENIED.
    // ═══════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
